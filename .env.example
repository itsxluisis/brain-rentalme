# Level 1 — Infrastructure Secrets
# Copy to .env and fill in values. Never commit .env to git.

# Database
DATABASE_URL=postgresql+asyncpg://brain:brain@localhost:5432/brain

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Encryption (for Level 3 credentials stored in Admin panel)
ENCRYPTION_MASTER_KEY=replace-with-64-char-hex-key

# Application
APP_ENV=development
CORS_ORIGIN=http://localhost:3000

# RAG retrieval tuning (optional, defaults shown)
RAG_MAX_CONTEXT_CHARS=2500
RAG_MIN_SIMILARITY=0.35

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
